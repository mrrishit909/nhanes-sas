47        +
48        +/* 2. One analysis file. Everyone stays in it: subgroups are domains, never subsets, so standard errors are right. */
49        +data nh;
50        +  merge demo_l(in=in_demo) bpxo_l bpq_l bmx_l hiq_l;
51        +  by seqn;
52        +  if in_demo;
53        +  sbp = mean(of bpxosy1-bpxosy3);                     /* average of up to three oscillometric readings */
54        +  dbp = mean(of bpxodi1-bpxodi3);
55        +  adult = (ridageyr >= 18 and sbp > . and dbp > . and wtmec2yr > 0 and ridexprg ne 1);   /* as the data brief */
56        +  meds = (bpq150 = 1);
57        +  htn = (sbp >= 130 or dbp >= 80 or meds);            /* 2017 ACC/AHA threshold, as the data brief */
58        +  if bpq020 in (1, 2) then aware = (bpq020 = 1);      /* don't know / refused stay missing */
59        +  controlled = (sbp < 130 and dbp < 80);
60        +  hyp = (adult and htn);
61        +  treated = (hyp and meds);
62        +  if hyp and aware ne . then unaware = 1 - aware;
63        +  if treated then uncontrolled = 1 - controlled;
64        +  length agegrp $5 sex $5 race $11 income $7 insured $7 bmi $7;
65        +  if 18 <= ridageyr < 40 then agegrp = '18-39'; else if 40 <= ridageyr < 60 then agegrp = '40-59'; else agegrp = '60+';
66        +  sex = ifc(riagendr = 1, 'Men', 'Women');
67        +  select (ridreth3);
68        +    when (1, 2) race = 'Hispanic';
69        +    when (3)    race = 'White';
70        +    when (4)    race = 'Black';
71        +    when (6)    race = 'Asian';
72        +    otherwise   race = 'Other';
73        +  end;
                                                           The SAS System

74        +  /* NHANES 2021-2023 has 15 strata and 30 PSUs: 15 design degrees of freedom, so the models keep categories few
75        +     (12 parameters) and leave unknown values out rather than modelling them */
76        +  if indfmpir > . then income = ifc(indfmpir < 2, '<2x', ifc(indfmpir < 4, '2-4x', '4x+'));
77        +  if hiq011 in (1, 2) then insured = ifc(hiq011 = 1, 'yes', 'no');
78        +  if bmxbmi > . then bmi = ifc(bmxbmi < 25, '<25', ifc(bmxbmi < 30, '25-30', '30+'));
79        +run;

